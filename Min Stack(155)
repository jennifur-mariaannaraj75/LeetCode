class MinStack {
    private Stack<Integer> st ;
    private Stack<Integer> minst ;
    public MinStack() {
        st= new Stack<>();
        minst= new Stack<>();
        
    }
    
    public void push(int value) {
        st.push(value);
        if(minst.isEmpty()||value<=minst.peek()){
            minst.push(value);
        }

        
    }
    
    public void pop() {
        if(st.isEmpty()){
            return;
        }
        if(st.peek().equals(minst.peek())){
            minst.pop();
        }
        st.pop();
    }
    
    public int top() {
        return st.peek();
    }
    
    public int getMin() {
        return minst.peek();
        
    }
}

