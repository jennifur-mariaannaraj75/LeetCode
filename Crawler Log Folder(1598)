class Solution {
    public int minOperations(String[] logs) {
        int depth=0;
        for(String log:logs){
            if(log.equals("../")){
                if(depth>0)
                    depth--;
            }else if(!log.equals("./"))
                    depth++;
                
        }
        return depth;
    }
}

Input
logs =
["d1/","d2/","../","d21/","./"]
Output
2
Expected
2
