class Solution {
    public int rob(int[] nums) {
        int prev2=0;
        int prev1=0;
        for(int money:nums){
            int curr=Math.max(
                prev1,
                prev2+money
            );
            prev2=prev1;
            prev1=curr;
        }
        return prev1;
    }
}

Input
nums =
[1,2,3,1]
Output
4
Expected
4
