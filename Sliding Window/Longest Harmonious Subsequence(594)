class Solution {
    public int findLHS(int[] nums) {
        Map<Integer,Integer> map=new HashMap<>();
        for(int num:nums){
            map.put(num,map.getOrDefault(num,0)+1);
        }
        int maxLen=0;
        for(int num:map.keySet()){
            if(map.containsKey(num+1)){
                maxLen=Math.max(maxLen,map.get(num)+map.get(num+1));
            }
        }
        return maxLen;
    }
}
Input
nums =
[1,3,2,2,5,2,3,7]
Output
5
