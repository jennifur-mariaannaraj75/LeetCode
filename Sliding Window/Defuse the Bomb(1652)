class Solution {
    public int[] decrypt(int[] code, int k) {
        int n=code.length;
        int[] ans=new int[n];
        if(k==0) return ans;
        int windowSum=0;
        int start = (k>0)?1:n+k;
        int end = (k>0)?k:n-1;

       
        for(int i=start;i<=end;i++){
            windowSum +=code[i];
        }
        for(int i=0;i<n;i++){
            ans[i]=windowSum;
            windowSum-=code[(i+start)%n];
            windowSum+=code[(i+end+1)%n];
        }
        return ans;
    }
}

