class Solution {
    public int minimumDifference(int[] nums, int k) {
        Arrays.sort(nums);

        int ans=Integer.MAX_VALUE;
        for(int i=0;i<=nums.length-k;i++){
            //ans=Math.min(ans,nums[i+k-1]-nums[i]);
            int diff=nums[i+k-1]-nums[i];
            if(diff<ans){
                ans=diff;
                if(ans==0){
                    return 0;
                }
            }
        }
        return ans;
    }
}

