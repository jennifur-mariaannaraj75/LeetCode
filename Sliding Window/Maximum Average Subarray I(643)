class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int sum=0;

        for(int i=0;i<k;i++){
            sum+=nums[i];
        }
        
        int maxSum=sum;

        for(int i=k;i<nums.length;i++){
            sum+=nums[i]-nums[i-k];
            maxSum=Math.max(sum,maxSum);
        }
        return (double)maxSum/k;
    }
}

Input
nums =
[1,12,-5,-6,50,3]
k =
4
Output
12.75000
Expected
12.75000
