class Solution {
    public int timeRequiredToBuy(int[] tickets, int k) {
        int time=0;
        int targetTicket=tickets[k];

        for(int i=0;i<tickets.length;i++){
            if(i<=k){
                time+=Math.min(tickets[i],targetTicket);
            }else{
                time+=Math.min(tickets[i],targetTicket-1);
            }
        }
        return time;
    }
}

Input
tickets =
[2,3,2]
k =
2
Output
6
Expected
6
