class Solution {
    public int[] sortedSquares(int[] nums) {
            int n=nums.length;
            int[] ans = new int[n];

            int left = 0, right = n-1;
            int  k = n-1;

            while(left<=right){
                if(Math.abs(nums[left])>Math.abs(nums[right])){
                    ans[k--]=nums[left]*nums[left++];
                }
                else
                    ans[k--]=nums[right]*nums[right--];
            }
            return ans;
        
    }
}


