class Solution {
    public int findContentChildren(int[] g, int[] s) {
        Arrays.sort(g);
        Arrays.sort(s);
        int child=0;
        int cookie=0;

        while(child<g.length && cookie<s.length){
            if(s[cookie]>=g[child]){
                child++;
            }
            cookie++;
        }
        return child;
    }
}

Input
g =
[1,2,3]
s =
[1,1]
Output
1
Expected
1
