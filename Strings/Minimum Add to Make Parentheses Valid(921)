class Solution {
    public int minAddToMakeValid(String s) {
        int openparenthesis=0;
        int closeparenthesis=0;
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(c=='('){
                openparenthesis++;
            }else{
                if(openparenthesis>0){
                    openparenthesis--;
                }else{
                    closeparenthesis++;
                }
            }
        }
        return openparenthesis+closeparenthesis;
        
    }
}

