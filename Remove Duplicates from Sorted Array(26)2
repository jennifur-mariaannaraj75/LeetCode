class Solution {
    public int removeDuplicates(int[] nums) {
        int i=0;
        for(int j=1;j<nums.length;j++){
            if(nums[j]!=nums[i]){
                i++;
                nums[i]=nums[j];
            }
        }
        
        return i+1;
        
    }
}

Input
nums =
[1,1,2]
Output
[1,2]
Expected
[1,2]
