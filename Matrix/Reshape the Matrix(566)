class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        int m=mat.length;
        int n=mat[0].length;
        if(m*n!=r*c){
            return mat;
        }
        int[][] result=new int[r][c];
        for(int i=0;i<m*n;i++){
            result[i/c][i%c]=mat[i/n][i%n];
        }
        return result;
    }
}

Input
mat =
[[1,2],[3,4]]
r =
1
c =
