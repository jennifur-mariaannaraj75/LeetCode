class Solution {
    public List<Integer> luckyNumbers(int[][] matrix) {
        List<Integer> result=new ArrayList<>();
        int row=matrix.length;
        int col=matrix[0].length;
        

        for(int i=0;i<row;i++){
            int min=Integer.MAX_VALUE;
            int minCol=-1;
            for(int j=0;j<col;j++){
                if(matrix[i][j]<min){
                    min=matrix[i][j];
                    minCol=j;
                }
               
            }
            boolean lucky=true;
            for(int k=0;k<row;k++){
                if(matrix[k][minCol]>min){
                    lucky=false;
                    break;
                }
            }
            if(lucky){
                result.add(min);
            }
        }
        return result;
    }
}
